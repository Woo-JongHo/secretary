specification {
  element person { style { shape person } }
  element system
  element component
  element artifact
}

model {
  user = person '사용자 · 최종 의사결정자'
  codex = system '준비된 Codex' {
    session = component '모델 · 인증 · 대화 · 세션 · 기본 도구'
  }
  assistant = system 'Assistant harness' {
    cli = component '설치 · 시작 · 기록 명령'
    skill = component '질문 흐름 · 사용자 결정 · 검증 지침'
    planning = component '계획 파일 처리 · 재개 지침' {
      description 'Oh My Pi v18.16.0에서 필요한 소스와 지침만 선별 이식해 직접 수정한다.'
    }
    conversation = component '질문 · 근거 · 단계 입력 계약' {
      description 'Gajae-Code v0.15.3의 질문·진행 보고·근거 스키마를 선별하여 수정한다. src/conversation.ts'
    }
    stages = component '단계 전환 · 실제 응답 · 변경 검사' {
      description 'src/stages.ts — 재개 가능한 단계 원문과 실제 산출물 해시를 보존한다.'
    }
    session = component '기록 · 요약 · 보고서 연결' {
      description 'src/session.ts와 src/project.ts — 원문에서 요약·보고서를 생성한다.'
    }
  }
  project = artifact '과제 코드 · 보고서 · 결정 · 계획 · 아키텍처 모델'
  likec4 = system 'LikeC4 검증 · 렌더링'
  pages = artifact '보고서 · 아키텍처 노드 View'

  user -> assistant.cli '과제 폴더에서 시작한다'
  assistant.cli -> codex.session '기존 설정으로 Codex를 실행한다'
  assistant.cli -> assistant.skill '프로젝트에 스킬 링크를 설치한다'
  assistant.skill -> codex.session '진행 규칙을 전달한다'
  user -> codex.session '문제를 설명하고 결정한다'
  codex.session -> assistant.cli '보고서 · 결정 · 계획 · View 명령을 실행한다'
  codex.session -> project '과제를 읽고 구현 · 검증한다'
  assistant.cli -> assistant.planning '기존 계획을 읽고 이어간다'
  assistant.cli -> assistant.session 'step · summary 명령을 전달한다'
  assistant.session -> assistant.conversation '질문·근거 형식을 검증하고 요약한다'
  assistant.session -> assistant.stages '단계 전환 · 응답 · 산출물 변경을 검사한다'
  assistant.stages -> project '단계 원문을 중복 없이 보존한다'
  assistant.session -> pages '단계별 요약과 보고서를 생성한다'
  assistant.cli -> project '보고서 · 실제 응답 근거 · 계획을 기록한다'
  assistant.cli -> likec4 '아키텍처 모델을 검증하고 빌드한다'
  likec4 -> pages '노드 페이지를 생성한다'
  assistant.cli -> pages '보고서와 갱신 상태를 만든다'
  user -> pages '진행과 구조를 읽는다'
}

views {
  view overview { title 'Assistant — Codex 기반 harness' include * }
  view runtime of assistant { title 'Assistant가 소유하는 코드' include * }
}

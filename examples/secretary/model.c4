specification {
  element person { style { shape person } }
  element system
  element component
  element artifact
}

model {
  pm = person 'PM · 최종 의사결정자'
  omp = system 'Oh My Pi' {
    session = component '대화 · 모델 · 세션 · 기본 도구'
    secretary = component 'Secretary 확장' {
      description '공통 질문 흐름, 보고서 갱신, 사용자 결정 기록, View 생성 명령'
    }
  }
  project = artifact '프로젝트 보고서 · 아키텍처 모델'
  likec4 = system 'LikeC4 검증 · 렌더링'
  pages = artifact 'PM 보고서 · 아키텍처 노드 View'

  pm -> omp.session '설명하고 대화한다'
  omp.secretary -> omp.session '질문 흐름과 보고서 맥락을 전달한다'
  pm -> omp.secretary '선택창에서 결정한다'
  omp.secretary -> project '보고서와 실제 사용자 선택을 기록한다'
  omp.secretary -> likec4 '아키텍처 모델을 검증하고 빌드한다'
  likec4 -> pages '노드 페이지를 생성한다'
  omp.secretary -> pages '보고서 페이지와 갱신 상태를 만든다'
  pm -> pages '진행 보고서와 구조를 읽는다'
}

views {
  view overview {
    title 'Secretary — Oh My Pi 기반 구조'
    include *
  }
  view runtime of omp {
    title 'Oh My Pi 안의 Secretary'
    include *
  }
}
